{
  "expo": {
    "name": "LazyNavy V3",
    "slug": "lazynavy-v3",
    "scheme": "lazynavyv3",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.lazynavy-v3",
      "appleTeamId": "N2UQHXDELE",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LazyNavy uses your location to record voyage and shore visit tracks while the app is open."
      }
    },
    "android": {
      "package": "com.anonymous.lazynavyv3",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#071d36"
      }
    }
  }
}
