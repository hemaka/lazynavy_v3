generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CREW
  CAPTAIN
  OWNER
  MERCHANT
}

model User {
  id                     String     @id @default(uuid())
  phone                  String?    @unique
  email                  String?    @unique
  passwordHash           String?
  nickname               String
  accountKind            String     @default("normal")
  internalEmail          String?    @unique
  managedById            String?
  birthYear              Int?
  guardianName           String?
  claimedAt              DateTime?
  avatar                 String?
  avatarUrl              String?
  coverImage             String?
  bio                    String?
  region                 String?
  country                String?
  firstLanguage          String?
  currency               String?
  timezone               String?
  textLanguage           String?
  uiLanguage             String?
  gender                 String     @default("private")
  birthDate              DateTime?  @db.Date
  sailingYears           Int?
  title                  String     @default("Harbor Rookie")
  level                  Int        @default(1)
  xp                     Int        @default(0)
  nextLevelXp            Int        @default(120)
  availableMileagePoints Int        @default(0)
  pendingMileagePoints   Int        @default(0)
  activeBadgeId          String?
  tokenVersion           Int        @default(0)
  roles                  UserRole[] @default([])
  verifiedRoles          UserRole[] @default([])
  isPublic               Boolean    @default(true)
  locationPolicy         String     @default("region")
  currentVesselId        String?
  deletedAt              DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  vessels            Vessel[]            @relation("VesselOwner")
  memberships        VesselMembership[]
  voyageParticipants VoyageParticipant[]
  logEntries         LogEntry[]
  discoveryUnlocks   DiscoveryUnlock[]
  poiConfirms        PoiConfirm[]
  rewardLedger       RewardLedger[]
  manuals            ManualDocument[]
  notifications      Notification[]
  chatMembers        ChatMember[]
  chatMessages       ChatMessage[]
  activeBadge        Badge?              @relation("UserActiveBadge", fields: [activeBadgeId], references: [id], onDelete: SetNull)
  availableBadges    UserBadge[]
  poiNotes           PoiNote[]
  poiReviews         PoiReview[]
  poiFavorites       PoiFavorite[]

  manager      User?  @relation("ManagedAccounts", fields: [managedById], references: [id])
  managedUsers User[] @relation("ManagedAccounts")

  @@index([activeBadgeId])
  @@index([managedById, accountKind])
}

model Badge {
  id          String   @id
  kind        String
  status      String   @default("active")
  title       String
  description String?
  imageKey    String?
  sortOrder   Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activeUsers User[]      @relation("UserActiveBadge")
  userBadges  UserBadge[]

  @@index([kind, status, sortOrder])
}

model UserBadge {
  id        String    @id @default(uuid())
  userId    String
  badgeId   String
  status    String    @default("available")
  source    String    @default("system")
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId, status])
  @@index([badgeId, status])
}

model Vessel {
  id                     String    @id @default(uuid())
  ownerId                String
  modelId                String?
  name                   String
  type                   String?
  homePort               String?
  registeredName         String?
  buildYear              Int?
  acquisitionYear        Int?
  title                  String    @default("First Wake")
  level                  Int       @default(1)
  xp                     Int       @default(0)
  nextLevelXp            Int       @default(180)
  badgesJson             Json?
  availableMileagePoints Int       @default(0)
  pendingMileagePoints   Int       @default(0)
  sceneTemplate          String    @default("open_sea")
  operationalStatus      String    @default("docked")
  setupStatus            String    @default("started")
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  owner            User               @relation("VesselOwner", fields: [ownerId], references: [id])
  model            VesselModel?       @relation(fields: [modelId], references: [id])
  memberships      VesselMembership[]
  invitations      VesselInvitation[]
  setupSteps       VesselSetupStep[]
  voyages          Voyage[]
  logEntries       LogEntry[]
  supplies         SupplyItem[]
  equipment        Equipment[]
  manuals          ManualDocument[]
  chatThreads      ChatThread[]
  discoveryUnlocks DiscoveryUnlock[]
  rewardLedger     RewardLedger[]

  @@index([ownerId, deletedAt])
  @@index([modelId])
}

model VesselModel {
  id                    String   @id @default(uuid())
  brand                 String
  model                 String
  type                  String?
  lengthFt              Float?
  yearStart             Int?
  yearEnd               Int?
  specsJson             Json?
  equipmentDefaultsJson Json?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  vessels Vessel[]

  @@unique([brand, model])
  @@index([type, active])
}

model VesselMembership {
  id        String   @id @default(uuid())
  vesselId  String
  userId    String
  role      String   @default("captain")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([vesselId, userId])
  @@index([userId])
}

model VesselRoleTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  rank        Int      @default(50)
  permissions Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VesselInvitation {
  id          String    @id @default(uuid())
  vesselId    String
  code        String    @unique
  role        String    @default("guest")
  invitedById String
  claimedById String?
  status      String    @default("active")
  expiresAt   DateTime?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id])

  @@index([vesselId, status])
  @@index([invitedById])
}

model VesselSetupStep {
  id            String    @id @default(uuid())
  vesselId      String
  key           String
  title         String
  status        String    @default("open")
  sortOrder     Int       @default(0)
  completedById String?
  completedAt   DateTime?
  skippedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id])

  @@unique([vesselId, key])
  @@index([vesselId, status])
}

model Voyage {
  id                String    @id @default(uuid())
  ownerId           String
  vesselId          String
  name              String
  status            String    @default("planned")
  departureName     String?
  destinationName   String?
  plannedStartAt    DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  needsConfirmation Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vessel           Vessel                @relation(fields: [vesselId], references: [id])
  participants     VoyageParticipant[]
  auditEvents      VoyageAuditEvent[]
  checklistItems   VoyageChecklistItem[]
  logEntries       LogEntry[]
  discoveryUnlocks DiscoveryUnlock[]

  @@index([ownerId, status])
  @@index([vesselId, status])
}

model VoyageParticipant {
  id          String    @id @default(uuid())
  voyageId    String
  userId      String
  role        String    @default("crew")
  status      String    @default("invited")
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  voyage Voyage @relation(fields: [voyageId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([voyageId, userId])
  @@index([userId, status])
}

model VoyageAuditEvent {
  id        String   @id @default(uuid())
  voyageId  String
  actorId   String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  voyage Voyage @relation(fields: [voyageId], references: [id])

  @@index([voyageId, createdAt])
}

model VoyageChecklistItem {
  id            String    @id @default(uuid())
  voyageId      String
  title         String
  category      String    @default("pre_voyage")
  status        String    @default("open")
  sortOrder     Int       @default(0)
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  voyage Voyage @relation(fields: [voyageId], references: [id])

  @@index([voyageId, status])
}

model LogEntry {
  id        String   @id @default(uuid())
  userId    String
  vesselId  String
  voyageId  String?
  type      String   @default("note")
  title     String
  body      String?
  photoUrl  String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  vessel           Vessel            @relation(fields: [vesselId], references: [id])
  voyage           Voyage?           @relation(fields: [voyageId], references: [id])
  discoveryUnlocks DiscoveryUnlock[]

  @@index([userId, createdAt])
  @@index([vesselId, createdAt])
  @@index([voyageId, createdAt])
}

model Poi {
  id            String   @id @default(uuid())
  version       Int      @default(1)
  legacySource  String?
  legacyUuid    String?
  legacyExId    Int?
  name          String
  type          String
  kind          String   @default("port")
  category      String   @default("marina")
  categoryGroup String   @default("berthing")
  subtype       String   @default("marina")
  slug          String?
  scope         String   @default("public")
  status        String   @default("unreviewed")
  lat           Float
  lng           Float
  region        String?
  country       String?
  address       String?
  description   String?
  rating        Float?
  phone         String?
  sourceUrl     String?
  picture       String?
  timezone      String?
  searchText    String?
  legacyStatus  Int?
  bestMonths    Int[]    @default([])
  sourcePayload Json?
  infoPayload   Json?
  extraPayload  Json?
  syncedAt      DateTime?
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  deletedBy     String?
  createdById   String?
  confirmCount  Int      @default(0)
  commentsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  confirms       PoiConfirm[]
  discoveryPoint DiscoveryPoint?
  berthing       PoiBerthing?
  notes          PoiNote[]
  reviews        PoiReview[]
  favorites      PoiFavorite[]

  @@index([categoryGroup])
  @@index([category])
  @@index([subtype])
  @@index([kind])
  @@index([type, status])
  @@index([lat, lng])
  @@unique([legacySource, legacyUuid])
}

model PoiBerthing {
  poiId             String   @id
  berthingTypes     String[] @default([])
  maxDraft          Float?
  maxLength         Float?
  maxBeam           Float?
  multihullFriendly Boolean?
  bookable          Boolean?
  overnightAllowed  Boolean?
  stayLimit         String?
  feeInfo           String?
  seabeds           String[] @default([])
  protections       String[] @default([])
  mooringTypes      String[] @default([])
  water             Boolean?
  power             Boolean?
  fuel              Boolean?
  toilets           Boolean?
  showers           Boolean?
  laundry           Boolean?
  groceries         Boolean?
  repair            Boolean?
  wasteDisposal     Boolean?
  dinghyLanding     Boolean?
  updatedAt         DateTime @updatedAt

  poi Poi @relation(fields: [poiId], references: [id], onDelete: Cascade)
}

model PoiConfirm {
  id        String   @id @default(uuid())
  poiId     String
  userId    String
  createdAt DateTime @default(now())

  poi  Poi  @relation(fields: [poiId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([poiId, userId])
  @@index([userId])
}

model PoiNote {
  id            String    @id @default(uuid())
  poiId         String
  status        String    @default("published")
  noteType      String    @default("info")
  text          String
  isPinned      Boolean   @default(false)
  isConfirmed   Boolean   @default(false)
  confirmedBy   String?
  confirmedAt   DateTime?
  createdBy     String?
  createdByRole String    @default("user")
  updatedBy      String?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  poi  Poi   @relation(fields: [poiId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([poiId, status])
  @@index([createdBy])
  @@index([deletedAt])
}

model PoiReview {
  id        String   @id @default(uuid())
  poiId     String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  poi  Poi  @relation(fields: [poiId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poiId, userId])
  @@index([userId])
}

model PoiFavorite {
  id        String   @id @default(uuid())
  poiId     String
  userId    String
  createdAt DateTime @default(now())

  poi  Poi  @relation(fields: [poiId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poiId, userId])
  @@index([userId])
}

model DiscoveryPoint {
  id             String   @id @default(uuid())
  poiId          String?  @unique
  name           String
  type           String
  lat            Float
  lng            Float
  radiusM        Int      @default(250)
  hidden         Boolean  @default(false)
  status         String   @default("approved")
  hint           String?
  description    String?
  discoveredById String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  poi     Poi?              @relation(fields: [poiId], references: [id])
  unlocks DiscoveryUnlock[]

  @@index([status, hidden])
}

model DiscoveryUnlock {
  id           String   @id @default(uuid())
  pointId      String
  userId       String
  vesselId     String
  voyageId     String
  logEntryId   String?
  photoUrl     String
  lat          Float
  lng          Float
  status       String   @default("unlocked")
  anomalyScore Float    @default(0)
  reviewNote   String?
  createdAt    DateTime @default(now())

  point    DiscoveryPoint @relation(fields: [pointId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  vessel   Vessel         @relation(fields: [vesselId], references: [id])
  voyage   Voyage         @relation(fields: [voyageId], references: [id])
  logEntry LogEntry?      @relation(fields: [logEntryId], references: [id])

  @@unique([pointId, userId, voyageId])
  @@index([vesselId, createdAt])
}

model SupplyItem {
  id        String   @id @default(uuid())
  vesselId  String
  name      String
  category  String   @default("general")
  unit      String   @default("pcs")
  quantity  Float    @default(0)
  capacity  Float?
  warnBelow Float?
  location  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id])

  @@index([vesselId, category])
}

model EquipmentTemplate {
  id                     String   @id @default(uuid())
  category               String   @default("other")
  brand                  String?
  model                  String?
  name                   String
  defaultMaintenanceDays Int?
  specsJson              Json?
  partsJson              Json?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  equipment Equipment[]

  @@index([category, active])
}

model Equipment {
  id                      String    @id @default(uuid())
  vesselId                String
  templateId              String?
  name                    String
  category                String    @default("other")
  brand                   String?
  model                   String?
  status                  String    @default("pending_confirmation")
  location                String?
  installedAt             DateTime?
  maintenanceIntervalDays Int?
  lastServicedAt          DateTime?
  nextDueAt               DateTime?
  partsJson               Json?
  metadata                Json?
  version                 Int       @default(1)
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  vessel             Vessel              @relation(fields: [vesselId], references: [id])
  template           EquipmentTemplate?  @relation(fields: [templateId], references: [id])
  maintenanceRecords MaintenanceRecord[]
  manuals            ManualDocument[]

  @@index([vesselId, status])
  @@index([nextDueAt])
  @@index([templateId])
}

model MaintenanceRecord {
  id              String    @id @default(uuid())
  vesselId        String
  equipmentId     String?
  type            String    @default("service")
  status          String    @default("open")
  title           String
  notes           String?
  performedAt     DateTime?
  dueAt           DateTime?
  cost            Float?
  completedById   String?
  sourceMessageId String?
  sourceActionId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@index([vesselId, status])
  @@index([equipmentId, createdAt])
  @@index([dueAt])
}

model ManualDocument {
  id              String    @id @default(uuid())
  ownerId         String
  vesselId        String?
  equipmentId     String?
  voyageId        String?
  title           String
  type            String    @default("knowledge")
  language        String?
  source          String?
  mediaUrl        String?
  contentText     String?
  metadata        Json?
  offlinePriority String    @default("normal")
  version         Int       @default(1)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id])
  vessel    Vessel?    @relation(fields: [vesselId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@index([ownerId, deletedAt])
  @@index([vesselId, type])
  @@index([equipmentId, type])
  @@index([voyageId, type])
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  vesselId   String?
  sourceType String
  sourceId   String
  type       String
  title      String
  body       String?
  status     String    @default("unread")
  severity   String    @default("info")
  payload    Json?
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, sourceType, sourceId, type])
  @@index([userId, status, createdAt])
  @@index([vesselId, createdAt])
}

model ChatThread {
  id        String   @id @default(uuid())
  vesselId  String?
  type      String   @default("boat")
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vessel   Vessel?       @relation(fields: [vesselId], references: [id])
  members  ChatMember[]
  messages ChatMessage[]

  @@unique([vesselId, type])
  @@index([type, updatedAt])
}

model ChatMember {
  id       String   @id @default(uuid())
  threadId String
  userId   String
  role     String   @default("member")
  status   String   @default("active")
  joinedAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])
  user   User       @relation(fields: [userId], references: [id])

  @@unique([threadId, userId])
  @@index([userId, status])
}

model ChatMessage {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  body      String
  kind      String   @default("text")
  metadata  Json?
  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])
  sender User       @relation(fields: [senderId], references: [id])

  @@index([threadId, createdAt])
}

model SyncMutation {
  id               String    @id @default(uuid())
  userId           String
  vesselId         String?
  clientMutationId String    @unique
  entityType       String
  operation        String
  payload          Json
  status           String    @default("received")
  error            String?
  createdAt        DateTime  @default(now())
  appliedAt        DateTime?

  @@index([userId, createdAt])
  @@index([vesselId, createdAt])
}

model RewardRule {
  id                    String   @id @default(uuid())
  key                   String   @unique
  sourceCategory        String
  xpAmount              Int      @default(0)
  mileageAmount         Int      @default(0)
  mileageRequiresReview Boolean  @default(true)
  dailyCap              Int?
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model RewardLedger {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique
  userId         String?
  vesselId       String?
  ruleKey        String
  sourceCategory String
  xpAmount       Int       @default(0)
  mileageAmount  Int       @default(0)
  mileageStatus  String    @default("pending")
  sourceType     String
  sourceId       String
  anomalyScore   Float?
  reviewNote     String?
  settledAt      DateTime?
  createdAt      DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  vessel Vessel? @relation(fields: [vesselId], references: [id])

  @@index([userId, createdAt])
  @@index([vesselId, createdAt])
  @@index([mileageStatus])
}

model MarineCondition {
  id                    String   @id @default(uuid())
  latBucket             Float
  lngBucket             Float
  timeBucket            DateTime
  source                String
  observedAt            DateTime?
  fetchedAt             DateTime @default(now())
  temperature           Float?
  pressure              Float?
  humidity              Float?
  visibility            Float?
  precipitation         Float?
  weatherCode           String?
  windSpeed             Float?
  windDirection         Float?
  windGust              Float?
  waveHeight            Float?
  waveDirection         Float?
  wavePeriod            Float?
  windWaveHeight        Float?
  windWaveDirection     Float?
  windWavePeriod        Float?
  swellWaveHeight       Float?
  swellWaveDirection    Float?
  swellWavePeriod       Float?
  seaSurfaceTemperature Float?
  rawData               Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([latBucket, lngBucket, timeBucket, source])
  @@index([latBucket, lngBucket, timeBucket])
  @@index([timeBucket])
  @@index([source, timeBucket])
}
