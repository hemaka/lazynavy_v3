generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  nickname        String
  avatarUrl       String?
  title           String   @default("Harbor Rookie")
  level           Int      @default(1)
  xp              Int      @default(0)
  nextLevelXp     Int      @default(120)
  availableMileagePoints Int @default(0)
  pendingMileagePoints   Int @default(0)
  tokenVersion    Int      @default(0)
  currentVesselId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vessels      Vessel[]          @relation("VesselOwner")
  memberships  VesselMembership[]
  voyageParticipants VoyageParticipant[]
  logEntries   LogEntry[]
  discoveryUnlocks DiscoveryUnlock[]
  poiConfirms  PoiConfirm[]
  rewardLedger RewardLedger[]
  manuals      ManualDocument[]
  notifications Notification[]
}

model Vessel {
  id            String   @id @default(uuid())
  ownerId       String
  name          String
  type          String?
  homePort      String?
  registeredName String?
  buildYear     Int?
  acquisitionYear Int?
  title         String   @default("First Wake")
  level         Int      @default(1)
  xp            Int      @default(0)
  nextLevelXp   Int      @default(180)
  badgesJson    Json?
  availableMileagePoints Int @default(0)
  pendingMileagePoints   Int @default(0)
  sceneTemplate String   @default("open_sea")
  setupStatus   String   @default("started")
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner        User               @relation("VesselOwner", fields: [ownerId], references: [id])
  memberships  VesselMembership[]
  invitations  VesselInvitation[]
  setupSteps   VesselSetupStep[]
  voyages      Voyage[]
  logEntries   LogEntry[]
  supplies     SupplyItem[]
  equipment    Equipment[]
  manuals      ManualDocument[]
  discoveryUnlocks DiscoveryUnlock[]
  rewardLedger RewardLedger[]

  @@index([ownerId, deletedAt])
}

model VesselMembership {
  id        String   @id @default(uuid())
  vesselId  String
  userId    String
  role      String   @default("captain")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([vesselId, userId])
  @@index([userId])
}

model VesselRoleTemplate {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  rank        Int      @default(50)
  permissions Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VesselInvitation {
  id           String    @id @default(uuid())
  vesselId     String
  code         String    @unique
  role         String    @default("guest")
  invitedById  String
  claimedById  String?
  status       String    @default("active")
  expiresAt    DateTime?
  claimedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id])

  @@index([vesselId, status])
  @@index([invitedById])
}

model VesselSetupStep {
  id          String    @id @default(uuid())
  vesselId    String
  key         String
  title       String
  status      String    @default("open")
  sortOrder   Int       @default(0)
  completedById String?
  completedAt DateTime?
  skippedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id])

  @@unique([vesselId, key])
  @@index([vesselId, status])
}

model Voyage {
  id                String    @id @default(uuid())
  ownerId           String
  vesselId          String
  name              String
  status            String    @default("planned")
  departureName     String?
  destinationName   String?
  plannedStartAt    DateTime?
  startedAt         DateTime?
  endedAt           DateTime?
  needsConfirmation Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id])
  participants VoyageParticipant[]
  auditEvents VoyageAuditEvent[]
  checklistItems VoyageChecklistItem[]
  logEntries LogEntry[]
  discoveryUnlocks DiscoveryUnlock[]

  @@index([ownerId, status])
  @@index([vesselId, status])
}

model VoyageParticipant {
  id          String   @id @default(uuid())
  voyageId    String
  userId      String
  role        String   @default("crew")
  status      String   @default("invited")
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  voyage Voyage @relation(fields: [voyageId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([voyageId, userId])
  @@index([userId, status])
}

model VoyageAuditEvent {
  id        String   @id @default(uuid())
  voyageId  String
  actorId   String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  voyage Voyage @relation(fields: [voyageId], references: [id])

  @@index([voyageId, createdAt])
}

model VoyageChecklistItem {
  id          String   @id @default(uuid())
  voyageId    String
  title       String
  category    String   @default("pre_voyage")
  status      String   @default("open")
  sortOrder   Int      @default(0)
  completedById String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  voyage Voyage @relation(fields: [voyageId], references: [id])

  @@index([voyageId, status])
}

model LogEntry {
  id        String   @id @default(uuid())
  userId    String
  vesselId  String
  voyageId  String?
  type      String   @default("note")
  title     String
  body      String?
  photoUrl  String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  vessel Vessel  @relation(fields: [vesselId], references: [id])
  voyage Voyage? @relation(fields: [voyageId], references: [id])
  discoveryUnlocks DiscoveryUnlock[]

  @@index([userId, createdAt])
  @@index([vesselId, createdAt])
  @@index([voyageId, createdAt])
}

model Poi {
  id           String   @id @default(uuid())
  name         String
  type         String
  scope        String   @default("public")
  status       String   @default("unreviewed")
  lat          Float
  lng          Float
  description  String?
  createdById  String?
  confirmCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  confirms PoiConfirm[]
  discoveryPoint DiscoveryPoint?

  @@index([type, status])
  @@index([lat, lng])
}

model PoiConfirm {
  id        String   @id @default(uuid())
  poiId     String
  userId    String
  createdAt DateTime @default(now())

  poi  Poi  @relation(fields: [poiId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([poiId, userId])
  @@index([userId])
}

model DiscoveryPoint {
  id          String   @id @default(uuid())
  poiId       String?  @unique
  name        String
  type        String
  lat         Float
  lng         Float
  radiusM     Int      @default(250)
  hidden      Boolean  @default(false)
  status      String   @default("approved")
  hint        String?
  description String?
  discoveredById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  poi Poi? @relation(fields: [poiId], references: [id])
  unlocks DiscoveryUnlock[]

  @@index([status, hidden])
}

model DiscoveryUnlock {
  id          String   @id @default(uuid())
  pointId     String
  userId      String
  vesselId    String
  voyageId    String
  logEntryId  String?
  photoUrl    String
  lat         Float
  lng         Float
  status      String   @default("unlocked")
  anomalyScore Float   @default(0)
  reviewNote   String?
  createdAt   DateTime @default(now())

  point    DiscoveryPoint @relation(fields: [pointId], references: [id])
  user     User           @relation(fields: [userId], references: [id])
  vessel   Vessel         @relation(fields: [vesselId], references: [id])
  voyage   Voyage         @relation(fields: [voyageId], references: [id])
  logEntry LogEntry?      @relation(fields: [logEntryId], references: [id])

  @@unique([pointId, userId, voyageId])
  @@index([vesselId, createdAt])
}

model SupplyItem {
  id        String   @id @default(uuid())
  vesselId  String
  name      String
  category  String   @default("general")
  unit      String   @default("pcs")
  quantity  Float    @default(0)
  capacity  Float?
  warnBelow Float?
  location  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vessel Vessel @relation(fields: [vesselId], references: [id])

  @@index([vesselId, category])
}

model EquipmentTemplate {
  id          String   @id @default(uuid())
  category    String   @default("other")
  brand       String?
  model       String?
  name        String
  defaultMaintenanceDays Int?
  specsJson   Json?
  partsJson   Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment[]

  @@index([category, active])
}

model Equipment {
  id          String   @id @default(uuid())
  vesselId    String
  templateId  String?
  name        String
  category    String   @default("other")
  brand       String?
  model       String?
  status      String   @default("pending_confirmation")
  location    String?
  installedAt DateTime?
  maintenanceIntervalDays Int?
  lastServicedAt DateTime?
  nextDueAt   DateTime?
  partsJson   Json?
  metadata    Json?
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vessel   Vessel @relation(fields: [vesselId], references: [id])
  template EquipmentTemplate? @relation(fields: [templateId], references: [id])
  maintenanceRecords MaintenanceRecord[]
  manuals ManualDocument[]

  @@index([vesselId, status])
  @@index([nextDueAt])
  @@index([templateId])
}

model MaintenanceRecord {
  id          String   @id @default(uuid())
  vesselId    String
  equipmentId String?
  type        String   @default("service")
  status      String   @default("open")
  title       String
  notes       String?
  performedAt DateTime?
  dueAt       DateTime?
  cost        Float?
  completedById String?
  sourceMessageId String?
  sourceActionId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@index([vesselId, status])
  @@index([equipmentId, createdAt])
  @@index([dueAt])
}

model ManualDocument {
  id          String   @id @default(uuid())
  ownerId     String
  vesselId    String?
  equipmentId String?
  voyageId    String?
  title       String
  type        String   @default("knowledge")
  language    String?
  source      String?
  mediaUrl    String?
  contentText String?
  metadata    Json?
  offlinePriority String @default("normal")
  version     Int      @default(1)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id])
  vessel    Vessel?    @relation(fields: [vesselId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@index([ownerId, deletedAt])
  @@index([vesselId, type])
  @@index([equipmentId, type])
  @@index([voyageId, type])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  vesselId    String?
  sourceType  String
  sourceId    String
  type        String
  title       String
  body        String?
  status      String   @default("unread")
  severity    String   @default("info")
  payload     Json?
  createdAt   DateTime @default(now())
  readAt      DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, sourceType, sourceId, type])
  @@index([userId, status, createdAt])
  @@index([vesselId, createdAt])
}

model RewardRule {
  id                   String   @id @default(uuid())
  key                  String   @unique
  sourceCategory       String
  xpAmount             Int      @default(0)
  mileageAmount        Int      @default(0)
  mileageRequiresReview Boolean @default(true)
  dailyCap             Int?
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model RewardLedger {
  id                String   @id @default(uuid())
  idempotencyKey    String   @unique
  userId            String?
  vesselId          String?
  ruleKey           String
  sourceCategory    String
  xpAmount          Int      @default(0)
  mileageAmount     Int      @default(0)
  mileageStatus     String   @default("pending")
  sourceType        String
  sourceId          String
  anomalyScore      Float?
  reviewNote        String?
  settledAt         DateTime?
  createdAt         DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  vessel Vessel? @relation(fields: [vesselId], references: [id])

  @@index([userId, createdAt])
  @@index([vesselId, createdAt])
  @@index([mileageStatus])
}
